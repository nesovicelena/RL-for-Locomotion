# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Weights & Biases
WANDB_API_KEY=
WANDB_PROJECT=rl-for-locomotion
WANDB_ENTITY=

# Where run directories are written.
#   laptop : ./experiments
#   runpod : /workspace/experiments   (the persistent network volume)
RL_EXPERIMENTS_DIR=./experiments

# MuJoCo rendering backend.
#   runpod (headless GPU) : egl
#   laptop                : glfw
MUJOCO_GL=egl

# JAX / XLA. Uncomment on the pod once you know the GPU memory budget.
# XLA_PYTHON_CLIENT_PREALLOCATE=false
# XLA_PYTHON_CLIENT_MEM_FRACTION=0.9
