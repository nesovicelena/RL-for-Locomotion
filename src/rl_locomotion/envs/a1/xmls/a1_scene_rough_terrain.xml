<mujoco model="a1 feetonly rough terrain scene">
  <include file="a1_mjx_feetonly.xml"/>

  <statistic center="0 0 0.1" extent="0.8" meansize="0.04"/>

  <visual>
    <rgba force="1 0 0 1"/>
    <global azimuth="120" elevation="-20"/>
    <map force="0.01"/>
    <scale forcewidth="0.3" contactwidth="0.5" contactheight="0.2"/>
    <quality shadowsize="8192"/>
  </visual>

  <asset>
    <!-- Playground's Go1 heightfield (locomotion/go1/xmls/assets/hfield.png):
         20 x 20 m, 5 cm peak-to-peak. Same scene as Go1JoystickRoughTerrain. -->
    <material name="groundplane" rgba="0.55 0.5 0.45 1" reflectance=".2"/>
    <hfield name="hfield" file="hfield.png" size="10 10 .05 1.0"/>
  </asset>

  <worldbody>
    <geom name="floor" type="hfield" hfield="hfield" material="groundplane" contype="1" conaffinity="0" priority="1"
      friction="1.0"/>
  </worldbody>

  <keyframe>
    <!-- Go1 rough keyframe is 0.35 = 0.278 + hfield clearance; A1 legs are 13 mm shorter. -->
    <key name="home" qpos="
    0 0 0.34
    1 0 0 0
    0.1 0.9 -1.8
    -0.1 0.9 -1.8
    0.1 0.9 -1.8
    -0.1 0.9 -1.8"
      ctrl="0.1 0.9 -1.8 -0.1 0.9 -1.8 0.1 0.9 -1.8 -0.1 0.9 -1.8"/>
  </keyframe>
</mujoco>
