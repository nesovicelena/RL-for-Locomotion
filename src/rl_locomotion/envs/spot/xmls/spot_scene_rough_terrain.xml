<mujoco model="spot feetonly rough terrain scene">
  <!-- Playground's own Spot model and its foot/floor contact sensors, resolved by
       basename from the asset dict (envs/spot/spot_joystick.get_assets). -->
  <include file="spot_mjx_feetonly.xml"/>

  <statistic center="0 0 0.1" extent="0.8" meansize="0.04"/>

  <visual>
    <rgba force="1 0 0 1"/>
    <global azimuth="120" elevation="-20"/>
    <map force="0.01"/>
    <scale forcewidth="0.3" contactwidth="0.5" contactheight="0.2"/>
    <quality shadowsize="8192"/>
  </visual>

  <asset>
    <!-- Playground's Go1 heightfield (locomotion/go1/xmls/assets/hfield.png):
         20 x 20 m, 5 cm peak-to-peak. The same terrain as Go1JoystickRoughTerrain
         and as the A1 and Berkeley rough scenes, so the four robots are evaluated
         on one rocky field. -->
    <material name="groundplane" rgba="0.55 0.5 0.45 1" reflectance=".2"/>
    <hfield name="hfield" file="hfield.png" size="10 10 .05 1.0"/>
  </asset>

  <worldbody>
    <!-- Friction 1.0 as on every rough scene (flat: 0.6). priority=1 so the floor's
         friction wins over the feet's and the friction sweep takes effect. -->
    <geom name="floor" type="hfield" hfield="hfield" material="groundplane" contype="1" conaffinity="0" priority="1"
      friction="1.0"/>
  </worldbody>

  <include file="sensor.xml"/>

  <keyframe>
    <!-- Flat keyframe is 0.46 m; +0.07 m clearance over the heightfield, the
         allowance Go1 (0.278 -> 0.35) and A1 (0.27 -> 0.34) use. -->
    <key name="home" qpos="
    0 0 0.53
    1 0 0 0
    0 1.04 -1.8
    0 1.04 -1.8
    0 1.04 -1.8
    0 1.04 -1.8"
      ctrl="
    0 1.04 -1.8
    0 1.04 -1.8
    0 1.04 -1.8
    0 1.04 -1.8"/>
  </keyframe>
</mujoco>
